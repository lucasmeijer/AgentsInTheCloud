{
  "name": "agents-in-the-cloud",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@earendil-works/pi-ai": "1.0.0",
      "@earendil-works/pi-coding-agent": "1.0.0",
      "@gespenst/core": "0.1.1",
      "@earendil-works/pi-durable": "1.0.0",
      "@earendil-works/chord": "1.0.0"
    }
  },
  "scripts": {
    "generate:workspace-modules": "bun run --cwd apps/web scripts/generate-workspace-modules.ts",
    "release": "bun run scripts/release.ts",
    "image:ensure-workspace": "bun scripts/ensure-workspace-image.ts",
    "test:workspace": "bun packages/workspace-image/scripts/integration.ts",
    "image:build": "bun run scripts/build-agents-in-the-cloud-image.ts",
    "image:publish": "bun run scripts/build-agents-in-the-cloud-image.ts --push --platform linux/amd64,linux/arm64",
    "check": "bun run generate:workspace-modules && bun run lint && bunx tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "test": "bun run generate:workspace-modules && bun test --parallel=4 --parallel-delay=0",
    "test:gateway": "bun run packages/proxy-ingress/scripts/test-workspace-gateway.ts",
    "ci": "bun ci && bun run check && bun run test",
    "web": "bun run --cwd apps/web dev",
    "preview:redesign": "bun run scripts/run-redesign-preview.ts",
    "prototype:dark-foundation": "bun run scripts/serve-dark-foundation-prototypes.ts",
    "kill": "bun run --cwd apps/web kill",
    "list": "bun run --cwd apps/web list",
    "demo:recording": "bun apps/web/demo/recording/example.ts"
  },
  "devDependencies": {
    "@agents-in-the-cloud/workspace-image": "workspace:*",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "1.61.0",
    "bun-types": "1.4.0",
    "oxlint": "1.78.0",
    "typebox": "^1.0.57",
    "typescript": "6.0.3"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@1.0.0": "patches/@earendil-works%2Fpi-ai@1.0.0.patch"
  }
}
